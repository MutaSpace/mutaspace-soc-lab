# lab-credentials.env.example
#
# Template for the environment variables every playbook in this area reads.
#
# Copy it, fill it in, and source it. Never commit the copy - ansible/.gitignore excludes
# lab-credentials.env and every other *.env file, but the habit matters more than the pattern:
#
#   cp lab-credentials.env.example lab-credentials.env
#   $EDITOR lab-credentials.env
#   set -a; . ./lab-credentials.env; set +a
#
# WHY ENVIRONMENT VARIABLES AND NOT ANSIBLE VAULT: both are defensible. Environment variables were
# chosen because this repository is public teaching material, and an encrypted vault file in a
# public repository invites exactly one question - "what is in it?" - and offers exactly one defence,
# a passphrase that is only as good as the person who chose it. Nothing secret exists in the
# repository at all this way. The cost is that credentials live in the operator's shell session and
# have to be re-exported in a new terminal, which is a real inconvenience and an honest trade.
#
# All of these are lab credentials for an isolated environment. That is not a reason to reuse a
# password from anywhere else.

# ---------------------------------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------------------------------

# Local Administrator on a freshly-cloned Windows template, as set by Cloudbase-Init or
# Autounattend. Used by the bootstrap_windows group, and only until the domain exists.
export MUTASPACE_WIN_ADMIN_PASSWORD='change-me'

# MUTASPACE\Administrator, after 10-dc-promote.yml has run. On a brand-new forest this is the same
# secret as the one above, because promotion converts the local account into the domain account.
# It is a separate variable so it can be rotated independently later without editing playbooks.
export MUTASPACE_DOMAIN_ADMIN_PASSWORD='change-me'

# Directory Services Restore Mode password, set once when the forest is created. It is not the
# domain administrator password and should not be the same string.
export MUTASPACE_SAFE_MODE_PASSWORD='change-me-too'

# ---------------------------------------------------------------------------------------------
# Lab accounts
# ---------------------------------------------------------------------------------------------

# Shared by test.user and lab.user02, the two accounts the incident scenarios depend on. Learners
# will type this one, so it wants to be memorable rather than strong - and it must still satisfy the
# domain's default password policy (8+ characters, three of four character classes).
export MUTASPACE_LAB_USER_PASSWORD='change-me-lab'

# ---------------------------------------------------------------------------------------------
# Linux
# ---------------------------------------------------------------------------------------------

# The cloud-init user baked into templates 9000, 9001 and 9005.
export MUTASPACE_LINUX_USER='labadmin'

# Path to the private key whose public half cloud-init installed on those templates.
export MUTASPACE_LINUX_SSH_KEY="$HOME/.ssh/mutaspace_lab_ed25519"

# Only needed if your template's cloud-init user does NOT have passwordless sudo. If you set this,
# also uncomment ansible_become_password in inventory/group_vars/linux.yml.
# export MUTASPACE_LINUX_BECOME_PASSWORD='change-me'

# ---------------------------------------------------------------------------------------------
# Wazuh API
# ---------------------------------------------------------------------------------------------

# Generated by the Wazuh installation assistant and captured by 40-wazuh-server.yml into
# .secrets/wazuh-passwords.txt. Read them out of that file after the server is installed; they do
# not exist before then, so 70-detections.yml is the only playbook that needs them.
export MUTASPACE_WAZUH_API_USER='wazuh'
export MUTASPACE_WAZUH_API_PASSWORD='read-this-out-of-.secrets/wazuh-passwords.txt'
