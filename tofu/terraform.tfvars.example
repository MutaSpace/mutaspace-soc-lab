# =============================================================================
# terraform.tfvars.example - copy to terraform.tfvars and fill in
# =============================================================================
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored. This file is not, so NOTHING REAL GOES IN IT.
#
# Note what is absent: there is no Proxmox endpoint and no API token here. Those
# are read from the environment by the provider itself, so there is no line in any
# committed file for someone to paste a real token into. See providers.tf.
#
#   export PROXMOX_VE_ENDPOINT="https://<LAB_MANAGEMENT_IP>:8006/"
#   export PROXMOX_VE_API_TOKEN="terraform@pve!provider=<uuid>"
#   export PROXMOX_VE_SSH_USERNAME="terraform"
#   export TF_VAR_state_passphrase="<at least 16 characters>"
#
# A gitignored .envrc plus direnv is the usual way to make those persistent.
#
# ---------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Proxmox endpoint behaviour
# -----------------------------------------------------------------------------

# A stock Proxmox install serves a self-signed certificate, so a lab almost always
# needs this. It defaults to false rather than true so that turning verification
# off is a visible, deliberate line in a file somebody has to edit.
pve_insecure = true

# Leave at "1.3" unless the host is Proxmox VE 8.x and the provider cannot reach
# it. A TLS version mismatch presents as an unreachable host, not as a TLS error,
# so this is worth trying early when the endpoint "does not respond".
# pve_min_tls = "1.2"

# PAM account on the node used for the SFTP upload path that cloud-init snippets
# need. Not the same thing as the API token. Falls back to PROXMOX_VE_SSH_USERNAME.
# pve_ssh_username = "terraform"

# -----------------------------------------------------------------------------
# fw-01's WAN leg - SECRET
# -----------------------------------------------------------------------------
# This is the operator's real upstream network. It never appears in lab.yaml, never
# in a commit, and never in documentation - repository policy is that public docs
# use <LAB_MANAGEMENT_IP> placeholders.
#
# "dhcp" is the right answer for a lab hanging off a home router, and it keeps the
# real subnet out of this file entirely.

wan_ipv4_mode = "dhcp"

# Only needed when wan_ipv4_mode = "static". Example values only - the real ones
# are yours and belong in the gitignored copy of this file.
# wan_ipv4_address = "10.0.0.50/24"
# wan_ipv4_gateway = "10.0.0.1"

# -----------------------------------------------------------------------------
# Guest access
# -----------------------------------------------------------------------------

# Public keys installed into the cloud-init admin account on every Linux guest.
# Public keys are not secrets, but they identify a person, so they are an input
# rather than a committed constant.
#
# With no key and no password there is no way into a Linux guest except the
# Proxmox console, and Ansible cannot reach them at all.
lab_ssh_authorized_keys = [
  # "ssh-ed25519 AAAAC3Nza... you@example",
]

# Console password for the same account. Prefer keys and leave this unset; it is
# here only because a teaching lab occasionally needs a console login while the
# network is the thing being deliberately broken.
#
# If you do use it, set it as TF_VAR_lab_admin_password rather than writing it into
# a file, even a gitignored one.
# lab_admin_password = "..."

# -----------------------------------------------------------------------------
# Classroom size
# -----------------------------------------------------------------------------

# How many of the learners listed in lab.yaml actually get machines built.
#
# The arithmetic on a 64 GB host: shared core ~28 GB, Proxmox host ~4 GB, each
# learner's endpoint pair another 8 GB. Three learners fits with the research plane
# (kali-01, untrusted-01, nlp-01) powered off. Raise this only after raising the RAM.
learner_count = 3

# ---------------------------------------------------------------------------------------
# Proxmox node name
# ---------------------------------------------------------------------------------------
# The node name as PROXMOX knows it. Leave commented out to use `site.node` from
# lab.yaml; set it if your host is named something else, which it will be.
#
# Find it with `hostname` on the host, or `pvesh get /nodes`.
#
# A wrong value fails at plan time with the real node names listed, rather than
# 404-ing in a way that looks like an authentication problem.
# pve_node = "my-proxmox-host"
